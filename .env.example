# 상담 폼 → 솔라피(SOLAPI) 알림 발송 설정
# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 커밋되지 않는다.
# 배포(Vercel)에서는 같은 키를 프로젝트 Environment Variables 에 넣어야 한다.

# --- 필수 (이게 없으면 폼이 503을 돌려주고 "연결되지 않았습니다"를 띄운다) ---
# 솔라피 콘솔 → 개발/연동 → API Key 관리
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 사전등록된 발신번호. 미등록 번호로는 발송 자체가 거부된다. 하이픈 없이.
SOLAPI_SENDER=01022724485

# --- 선택 ---
# 알림 받을 번호. 비우면 SITE.phone(사이트에 노출된 대표 번호)으로 보낸다. 하이픈 없이.
CONSULT_NOTIFY_TO=
# 고객에게 "접수되었습니다" 확인 발송. 기본 꺼짐(대표 알림만 나간다).
# 켜려면 1. 건당 비용이 대략 2배가 된다.
CONSULT_NOTIFY_CUSTOMER=0

# --- 카카오 알림톡 (템플릿 승인 후에만 채운다) ---
# 셋 다 비어 있으면 알림톡 단계를 건너뛰고 문자만 나간다. 코드 수정 불필요.
# pfId = 솔라피에 연동한 카카오 비즈니스 채널 ID
SOLAPI_KAKAO_PFID=
# 대표 알림용 템플릿. 변수: #{name} #{phone} #{topic} #{message}
SOLAPI_KAKAO_TEMPLATE_OWNER=
# 고객 접수확인용 템플릿. 변수: #{name} #{topic}
# CONSULT_NOTIFY_CUSTOMER=1 일 때만 쓰인다 — 현재는 꺼져 있으므로 비워둬도 된다.
SOLAPI_KAKAO_TEMPLATE_CUSTOMER=

# 개발 전용: 1이면 솔라피를 호출하지 않고 성공한 것처럼 반환한다.
# 실제 발송·과금 없이 폼 전체 경로를 테스트할 때 쓴다.
# 프로덕션(NODE_ENV=production)에서는 값과 무관하게 무시된다.
CONSULT_DRY_RUN=0
